# Copy to .env; never commit real credentials. Node.js 22+ loads it natively.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

DATABASE_URL=postgresql://dayflow_app:replace_with_local_password@localhost:5432/dayflow
DB_SSL=false
# For TLS-enabled servers: true above, verified CA bundle below if needed.
# DB_SSL_CA_FILE=/absolute/path/to/postgres-ca.pem
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=6000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000

# Optional infrastructure. Leave disabled until you implement a Redis-backed feature.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000

# Reserved for the authentication learning milestone; auth is not implemented.
SESSION_COOKIE_NAME=dayflow_session
SESSION_TTL_DAYS=7
