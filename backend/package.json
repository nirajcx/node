{
  "name": "dayflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/unit/*.test.js tests/integration/http.test.js tests/integration/startup.test.js tests/integration/redis.test.js",
    "test:db": "node --env-file=.env --test tests/integration/database.test.js",
    "db:check": "node --env-file=.env scripts/check-db.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  }
}
